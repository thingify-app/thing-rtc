{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thingify-signalling",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"migrations": [
		{
			"new_sqlite_classes": [
				"SignallingServer"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "SignallingServer",
				"name": "SIGNALLING_SERVER"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
